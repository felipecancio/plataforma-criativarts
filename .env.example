# Meta Pixel (browser)
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (servidor — Purchase no webhook Asaas/MP)
# Events Manager → Configurações → API de Conversões → Gerar token de acesso
META_CAPI_ACCESS_TOKEN=
# Opcional: se vazio, usa NEXT_PUBLIC_META_PIXEL_ID
# META_PIXEL_ID=

# Future: Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alias aceito (mesma chave publishable/anon do dashboard):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: para scripts de sync/admin e webhook do Mercado Pago (nunca exponha no client)
# SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Checkout Bricks)
# Public Key → browser | Access Token → apenas servidor
# Teste: ambas as chaves com prefixo TEST- (mesmo aplicativo)
# Produção: ambas as chaves live (sem TEST-), mesmo aplicativo — nunca misture
NEXT_PUBLIC_MP_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: força checagem explícita (test | production)
# MP_ENV=test

# URL pública do site (obrigatória em produção para notification_url / webhook / e-mails / Checkout Pro)
# Ex.: https://criativarts.com
APP_URL=
# NEXT_PUBLIC_APP_URL=

# Checkout: brick | pro | asaas
# brick  = Payment Brick (Mercado Pago, exige login)
# pro    = Checkout Pro (Mercado Pago, guest ok)
# asaas  = Asaas Checkout hospedado Pix+cartão (guest ok)
# Use NEXT_PUBLIC_ para o frontend decidir a UI (precisa redeploy na Vercel).
# Default / rollback: brick
NEXT_PUBLIC_CHECKOUT_MODE=brick
# CHECKOUT_MODE=brick

# Asaas (Checkout hospedado — somente servidor)
# Produção: ASAAS_ENV=production + chave de produção → https://api.asaas.com/v3
# Sandbox:  ASAAS_ENV=sandbox + chave sandbox → https://api-sandbox.asaas.com/v3
# IMPORTANTE: chaves Asaas começam com $. No .env.local o Next expande $VAR e zera a chave.
# Escape o cifrão: ASAAS_API_KEY=\$aact_hmlg_...  (na Vercel cole a chave normal, sem \)
ASAAS_API_KEY=
ASAAS_ENV=production
# Token gerado no Webhook Asaas (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=

# Resend (e-mail de acesso pós-compra — somente servidor)
RESEND_API_KEY=
# Ex.: Criativarts <noreply@criativarts.com>
RESEND_FROM=

# Cloudflare R2 (bucket privado — somente servidor)
# API Tokens S3: Account ID + Access Key ID + Secret Access Key + nome do bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
